{
  "name": "ai-game-maker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "kv_namespaces": [
    {
      "binding": "GAME_KV",
      "id": "bc75ba4dd23e440e9796a960337afc68",
      "preview_id": "027ec5d3c3c34050979cb2d8c4dec28b"
    }
  ],
  "routes": [
    {
      "pattern": "ai-game.ryopc.org/*",
      "zone_name": "ryopc.org"
    }
  ]
}